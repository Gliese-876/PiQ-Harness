{
  "name": "piq-harness",
  "version": "0.1.0",
  "description": "Tencent official QQ Bot channel for shared Pi conversation groups",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "qqbot",
    "qq"
  ],
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "web": "node src/web.ts",
    "piq": "node src/cli.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "verify": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^26.0.0",
    "typebox": "^1.1.3",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "1.0.5"
  }
}
